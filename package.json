{
	"name": "moshu",
	"version": "0.0.1",
	"private": true,
	"license": "MIT",
	"packageManager": "bun@1.3.14",
	"engines": {
		"bun": "1.3.14"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "bun run --cwd apps/desktop dev",
		"dev:hmr": "bun run --cwd apps/desktop dev:hmr",
		"build": "bun run --cwd apps/desktop build:web",
		"package:canary": "bun run --cwd apps/desktop package:canary",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"lint": "biome lint .",
		"typecheck": "bun run --filter '@moshu/*' typecheck",
		"test:unit": "bun test packages",
		"test:web": "bun run --cwd apps/desktop test",
		"test": "bun run test:unit && bun run test:web",
		"check": "bun run format:check && bun run lint && bun run typecheck && bun run test"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.4",
		"@types/bun": "1.3.14",
		"typescript": "5.9.3"
	}
}
