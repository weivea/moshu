{
	"name": "@moshu/desktop",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun run ./scripts/dev-three-process.ts",
		"dev:hmr": "concurrently --kill-others-on-fail \"bun run hmr\" \"bun run dev\"",
		"hmr": "vite --port 5173",
		"build:web": "vite build",
		"package:canary": "bun run ./scripts/package-canary.ts",
		"typecheck": "tsc --noEmit -p tsconfig.bun.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.config.json",
		"test:bun": "bun test src/bun scripts",
		"test:web": "vitest run",
		"test": "bun run test:bun && bun run test:web"
	},
	"dependencies": {
		"@moshu/contracts": "workspace:*",
		"@moshu/process-rpc": "workspace:*",
		"@moshu/ui": "workspace:*",
		"@heroui/react": "3.2.2",
		"@heroui/styles": "3.2.2",
		"electrobun": "1.18.1",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"react-router-dom": "7.18.1",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@tailwindcss/vite": "4.3.3",
		"@testing-library/jest-dom": "6.9.1",
		"@testing-library/react": "16.3.2",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"@types/three": "0.165.0",
		"@vitejs/plugin-react": "4.7.0",
		"concurrently": "10.0.3",
		"jsdom": "26.1.0",
		"tailwindcss": "4.3.3",
		"vite": "6.4.3",
		"vitest": "3.2.7"
	}
}